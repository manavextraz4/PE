rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection (Profiles)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
                    && incoming().id == userId;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId
                    && incoming().id == userId;
      allow delete: if false;
    }

    // Enquiries Collection
    match /enquiries/{enquiryId} {
      allow get: if isSignedIn() && isValidId(enquiryId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(enquiryId)
                    && incoming().userId == request.auth.uid
                    && incoming().id is string;
      allow update: if isSignedIn() && isValidId(enquiryId)
                    && resource.data.userId == request.auth.uid
                    && incoming().userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
